# TabsForge School OS - environment configuration
DEBUG=True
SECRET_KEY=change-me-to-a-secure-random-string-in-production
DATABASE_URL=postgres://tabsforge:password@localhost:5432/tabsforge_db
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=False
TIME_ZONE=UTC
CONN_MAX_AGE=60
LOG_LEVEL=INFO
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
FRONTEND_URL=https://tabsforge.com

# ── Email ────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@tabsforge.com

# ── SMS (termii recommended for Nigeria) ─────────────────────────────
# SMS_PROVIDER=stub | termii | africastalking | twilio
SMS_PROVIDER=stub
TERMII_API_KEY=
TERMII_SENDER_ID=TabsForge
TERMII_BASE_URL=https://v3.api.termii.com
TERMII_CHANNEL=generic

# ── Payments (online collections) ────────────────────────────────────
# Endpoints answer 503 until the matching secret key is configured.
PAYMENT_PROVIDER=manual
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com
FLUTTERWAVE_SECRET_HASH=
